[Unit]
Description=Neuropost Telegram Bot
After=network.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/neuropost_bot
ExecStart=/home/YOUR_LINUX_USER/neuropost_bot/venv/bin/python main.py
Restart=on-failure
RestartSec=10
EnvironmentFile=/home/YOUR_LINUX_USER/neuropost_bot/.env

[Install]
WantedBy=multi-user.target
